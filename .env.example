# Non-secret runtime settings only. Secrets belong in macOS Keychain.
POLYMARKET_PROFILE_ADDRESS=0x0000000000000000000000000000000000000000
POLYMARKET_DB_PATH=./data/polymarket.sqlite
POLYMARKET_APPROVAL_HOST=127.0.0.1
POLYMARKET_APPROVAL_PORT=8787
POLYMARKET_LIVE_ENABLED=false
PAPER_GATE_SKIP=false
POLYMARKET_KEYCHAIN_SERVICE=codex-polymarket-guarded
POLYGON_RPC_URL=https://polygon-rpc.com
# Required only when POLYMARKET_LIVE_ENABLED=true: two independent origins.
POLYGON_RPC_URLS=https://rpc-provider-one.example,https://rpc-provider-two.example
